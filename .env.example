# Cloud/API
PORT=8080
DATA_STORE=sqlite
SQLITE_PATH=data/runtime/rfid.db
# key id -> tenant, reader and secret. Store secrets in a secret manager in production.
DEVICE_CREDENTIALS={"pilot-reader":{"tenantId":"globaltex-demo","readerId":"dock-door-1","secret":"replace-this-secret"}}
ADMIN_TOKEN=replace-this-admin-password
ADMIN_TENANT_ID=globaltex-demo
SESSION_SECRET=replace-with-at-least-24-random-characters
COOKIE_SECURE=false
BACKUP_DIR=data/backups
# PostgreSQL migration/runtime preparation
# DATABASE_URL=postgresql://globaltex:replace-password@127.0.0.1:5432/globaltex_rfid
PGSSL=disable
PGSSL_REJECT_UNAUTHORIZED=true
PGPOOL_MAX=20
PGPOOL_IDLE_MS=30000
PGCONNECT_TIMEOUT_MS=10000
# Optional RBAC replacement for ADMIN_TOKEN. Object keys are login tokens.
# ADMIN_IDENTITIES={"replace-chain-token":{"actorId":"ops@example.com","role":"chain_admin","tenantIds":["hotel-a","hotel-b"],"defaultTenantId":"hotel-a"}}
# Tenant -> ERP/PMS/WMS signed webhook configuration used by npm run integration:flush
# INTEGRATION_ENDPOINTS={"hotel-a":{"endpoint":"https://erp.example.com/rfid-events","secret":"replace-webhook-secret"}}

# Edge Gateway
API_URL=http://127.0.0.1:8080
DEVICE_KEY=pilot-reader
DEVICE_SECRET=replace-this-secret
FACILITY_ID=hotel-miami-1
ZONE_ID=receiving
READER_ID=dock-door-1
# Built-in id (simulate/stdin) or an explicit local adapter module path.
ADAPTER=simulate
ADAPTER_CONFIG={}
# FCC_US for United States readers; ETSI_TR only for the Türkiye encoding station.
REGULATORY_REGION=FCC_US
# Persistent Edge queue. EDGE_QUEUE_KEY is required when NODE_ENV=production.
EDGE_QUEUE_PATH=data/runtime/edge-queue.db
EDGE_QUEUE_KEY=replace-with-a-long-random-edge-queue-key
# Optional open scan session created by the admin API
SESSION_ID=
