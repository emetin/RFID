{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://globaltexusa.com/schemas/rfid/tag-read-batch-v1.json",
  "title": "Globaltex RFID Tag Read Batch",
  "type": "object",
  "additionalProperties": false,
  "required": ["facilityId", "zoneId", "events"],
  "properties": {
    "facilityId": { "type": "string", "minLength": 1 },
    "zoneId": { "type": "string", "minLength": 1 },
    "sessionId": { "type": "string", "minLength": 1 },
    "events": {
      "type": "array",
      "minItems": 1,
      "maxItems": 5000,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["eventId", "epc", "observedAt"],
        "properties": {
          "eventId": { "type": "string", "minLength": 1 },
          "epc": { "type": "string", "pattern": "^[0-9A-F]{8,96}$" },
          "observedAt": { "type": "string", "format": "date-time" },
          "rssi": { "type": "number" },
          "antenna": { "type": "integer", "minimum": 0 }
        }
      }
    }
  }
}

